# ==============================================================================
# ACCESSOS Environment Configuration Template (Production & Development)
# ==============================================================================
# Copy this file to .env before starting services:
#   Windows: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
#
# IMPORTANT: Never commit .env or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PROJECT_NAME="ACCESSOS Backend"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# In development, localhost and browser extension schemes are permitted.
# In production, specify explicit domains. Wildcard '*' is strictly prohibited.
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","chrome-extension://*"]

# ------------------------------------------------------------------------------
# AI Provider Configuration (Optional)
# ------------------------------------------------------------------------------
# Supported values: "mock", "openai", "gemini", "openrouter", "disabled"
# ACCESSOS defaults safely to "mock" for local deterministic execution.
# The backend starts and operates normally without third-party API keys.
AI_PROVIDER="mock"
AI_MODEL=""

# Placeholders for optional third-party AI keys:
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# AI Request Limits & Safeguards
AI_TIMEOUT_SECONDS=25.0
AI_MAX_PAYLOAD_BYTES=65536
AI_MAX_BARRIER_FINDINGS=10

# ------------------------------------------------------------------------------
# Extension & API Endpoints
# ------------------------------------------------------------------------------
API_BASE_URL="http://localhost:8000"
VITE_BACKEND_URL="http://localhost:8000"
